# Supabase Configuration
# Copy this file to .env.local and fill in your actual values

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (ONLY use on server, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admissions inquiry emails (sent with nodemailer through Gmail)
# 1. Turn on 2-Step Verification for the Gmail account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Put the Gmail address and the 16-character app password below.
#    These are server-only secrets: never prefix them with NEXT_PUBLIC_.
GMAIL_USER=your-school-gmail@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Optional: where inquiries are delivered. Defaults to GMAIL_USER.
INQUIRY_TO_EMAIL=
